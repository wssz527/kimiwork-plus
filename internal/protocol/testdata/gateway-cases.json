        "input": [
          {
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "look it up"
              }
            ]
          },
          {
            "type": "function_call",
            "call_id": "call_2",
            "name": "lookup",
            "arguments": "{\"id\":7}"
          },
          {
            "type": "function_call_output",
            "call_id": "call_2",
            "output": "{\"value\":\"ok\"}"
          },
          {
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "thanks"
              }
            ]
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "lookup",
            "parameters": {
              "type": "object"
            }
          }
        ]
      },
      "upstream": {
        "status": 200,
        "contentType": "application/json",
        "body": "{\"id\": \"msg_fx\", \"type\": \"message\", \"role\": \"assistant\", \"model\": \"claude-fx\", \"content\": [{\"type\": \"text\", \"text\": \"done\"}], \"stop_reason\": \"end_turn\", \"usage\": {\"input_tokens\": 5, \"output_tokens\": 2}}"
      }
