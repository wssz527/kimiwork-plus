    {
      "name": "anthropic-chat-tool-roundtrip-request",
      "route": "/v1/chat/completions",
      "models": [
        {
          "id": "kimi-claude",
          "protocol": "chat",
          "contextWindow": 200000,
          "upstreamProtocol": "anthropic"
        }
      ],
      "request": {
        "model": "kimi-claude",
        "max_tokens": 512,
        "temperature": 0.25,
        "stop": "END",
        "reasoning_effort": "xhigh",
        "messages": [
          {
            "role": "system",
            "content": "be terse"
          },
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "what is this?"
              },
              {
                "type": "image_url",
                "image_url": {
                  "url": "data:image/png;base64,AAAA"
                }
              },
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://example.test/a.jpg"
                }
              }
            ]
          },
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_1",
                "type": "function",
                "function": {
                  "name": "weather",
                  "arguments": "{\"city\":\"Paris\"}"
                }
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_1",
            "content": "{\"temperature\":20}"
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "weather",
              "description": "lookup",
              "parameters": {
                "type": "object",
                "properties": {}
              }
            }
          }
        ],
        "tool_choice": "auto"
      },
      "upstream": {
        "status": 200,
        "contentType": "application/json",
        "body": "{\"id\": \"msg_fx\", \"type\": \"message\", \"role\": \"assistant\", \"model\": \"claude-fx\", \"content\": [{\"type\": \"text\", \"text\": \"20C\"}], \"stop_reason\": \"end_turn\", \"usage\": {\"input_tokens\": 5, \"output_tokens\": 2}}"
      }
    },
    {
      "name": "anthropic-responses-tool-roundtrip-request",
      "route": "/v1/responses",
      "models": [
        {
          "id": "claude-fx",
          "protocol": "responses",
